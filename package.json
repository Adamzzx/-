{
  "name": "crypto-exchange-guide",
  "version": "1.0.0",
  "description": "Chinese comparison-first exchange website and CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "next start --hostname 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "db:migrate": "payload migrate",
    "setup:local": "node scripts/setup-local.mjs",
    "db:start": "docker compose up -d db",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
